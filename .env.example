# ==============================================================================
# Jira MCP 連線環境變數範本 (請複製為 .env 並填入真實金鑰，.env 已被 gitignore)
# ==============================================================================

# Jira 執行個體網址 (例如: https://your-company.atlassian.net)
JIRA_HOST=https://your-company.atlassian.net

# Jira 登入帳號 / Email (例如: developer@your-company.com)
JIRA_EMAIL=your-email@company.com

# Jira API Token (可在 https://id.atlassian.net/manage-profile/security/api-tokens 建立)
JIRA_API_TOKEN=your_jira_api_token_here
